      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Allergy Intolerance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
