{
  "opencollection": "1.0.0",
  "info": {
    "name": "Temple Health FHIR R4 Allergy Intolerance API",
    "version": "4.0.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://epicaccess.templehealth.org/FhirProxyPrd/oauth2/authorize",
